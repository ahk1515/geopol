{
  "_doc": {
    "description": "Référentiel des institutions créancières (multilatérales et agrégats) apparaissant en subcategory_2 de la dette extérieure. Indexé par le sigle EXACT tel qu'il figure dans la base. Sert à nommer en clair les détenteurs et à exposer l'actionnariat (concentration de contrôle). Les créanciers-pays (codes ISO3 : FRA, CHN, USA...) ne sont PAS ici : ils sont gérés par isoToName.",
    "champs": {
      "nom_fr": "nom complet en français",
      "nom_en": "nom officiel anglais",
      "siege_ville": "ville du siège",
      "siege_pays": "ISO3 du pays du siège",
      "zone": "zone de couverture (Afrique, Asie, Amérique latine, mondial...)",
      "type": "banque_dev_regionale | banque_dev_multilaterale | fonds | agregat",
      "nb_membres": "nombre de membres/actionnaires (null si inconnu)",
      "actionnaire_1": "ISO3 du 1er actionnaire (null si dilué/inconnu)",
      "part_1_pct": "part de vote/capital du 1er actionnaire en % (null si inconnu)",
      "veto": "true si le 1er actionnaire dispose d'un veto de fait (>=25% sur votes à supermajorité)",
      "confiance": "verifie_web | haute | a_relire | introuvable",
      "zones_geo": "liste de zone_id GEO de l'app couverts par l'institution ([] = mondial ou sans objet)"
    },
    "seuil_captation_suggere_pct": 25
  },
